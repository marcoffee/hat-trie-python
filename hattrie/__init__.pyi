from collections.abc import Generator, Mapping
from typing import overload


class HatTrieMap[T]:
    def __init__(self) -> None: ...
    def clear(self) -> None: ...
    def count(self, stringkey: bytes) -> int: ...
    def empty(self) -> bool: ...
    def erase_prefix(self, stringprefix: bytes) -> int: ...
    def get[DefT](self, key: bytes, value: DefT = None) -> T | DefT: ...
    def insert(self, stringkey: bytes, value: T) -> bool: ...
    def items(self) -> Generator[tuple[bytes, T]]: ...
    def keys(self) -> Generator[bytes]: ...
    def longest_prefix(self, stringkey: bytes) -> Generator[tuple[bytes, T]]: ...
    def max_key_size(self) -> int: ...
    def max_size(self) -> int: ...
    @overload
    def pop[DefT](self, key: bytes) -> T: ...
    @overload
    def pop[DefT](self, key: bytes, default: DefT) -> T | DefT: ...
    def shrink_to_fit(self) -> None: ...
    def size(self) -> int: ...
    def update(self, map: Mapping[bytes, T]) -> None: ...
    def values(self) -> Generator[T]: ...
    def __contains__(self, other: bytes) -> bool: ...
    def __delitem__(self, other: bytes) -> None: ...
    def __getitem__(self, index: bytes) -> T: ...
    def __iter__(self) -> Generator[bytes]: ...
    def __setitem__(self, index: bytes, object: T) -> None: ...
